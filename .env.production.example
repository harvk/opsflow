# NON-SECRET Compose interpolation only. Copy to .env.production in 12.6D.
# Replace all placeholder values before deployment; never commit the copy.
OPSFLOW_IMAGE_TAG=phase12-6c
PYTHON_VERSION=3.13.15
NODE_VERSION=24
AWS_REGION=us-east-1
FRONTEND_ORIGIN=https://YOUR-APP-DOMAIN
PASSWORD_RESET_URL=https://YOUR-APP-DOMAIN/reset-password
SES_FROM_EMAIL=YOUR-VERIFIED-SES-SENDER
TASK_QUEUE_URL=YOUR-EXISTING-TASK-QUEUE-URL
REALTIME_NOTIFICATION_QUEUE_URL=YOUR-EXISTING-REALTIME-QUEUE-URL
TASK_EXECUTION_TABLE_NAME=YOUR-TERRAFORM-TASK-EXECUTION-TABLE
TASK_EXECUTION_STATUS_INDEX_NAME=YOUR-TERRAFORM-STATUS-INDEX
OPSFLOW_LOCAL_HTTP_PORT=8080

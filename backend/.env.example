# ==========================================================
# OPSFLOW BACKEND APPLICATION CONFIGURATION TEMPLATE
# ==========================================================
#
# Copy this file locally as:
#
#     backend/.env
#
# Never commit the real backend/.env file.
#
# Docker Compose orchestration values belong in:
#
#     /.env.docker
#
# compose.yaml loads this file for Backend application
# settings and overrides distributed runtime values through
# the Compose environment section.
#
# ==========================================================


# ==========================================================
# APPLICATION
# ==========================================================

APP_NAME=OpsFlow API

APP_ENV=development

API_V1_PREFIX=/api/v1

FRONTEND_ORIGIN=http://localhost:5173

METRICS_ENABLED=true


# ==========================================================
# DATABASE
# ==========================================================
#
# These values support host-side Backend development.
#
# Docker Compose overrides them with addresses using the
# private PostgreSQL service name:
#
#     db:5432
#
# ==========================================================

DATABASE_URL=postgresql+psycopg://opsflow:replace_me@localhost:5433/opsflow

TEST_DATABASE_URL=postgresql+psycopg://opsflow:replace_me@localhost:5433/opsflow_test


# ==========================================================
# JWT AUTHENTICATION
# ==========================================================

JWT_SECRET_KEY=replace-with-a-strong-random-secret

JWT_REFRESH_SECRET_KEY=replace-with-a-different-strong-random-secret

JWT_REAUTH_SECRET_KEY=replace-with-another-strong-random-secret

JWT_ALGORITHM=HS256

JWT_ISSUER=opsflow-api

JWT_AUDIENCE=opsflow-web


# ==========================================================
# TOKEN LIFETIMES
# ==========================================================

ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=7

REAUTH_TOKEN_EXPIRE_MINUTES=5


# ==========================================================
# CSRF
# ==========================================================

CSRF_SECRET_KEY=replace-with-a-strong-random-secret

CSRF_COOKIE_NAME=opsflow_csrf

CSRF_HEADER_NAME=X-CSRF-Token


# ==========================================================
# REFRESH COOKIE
# ==========================================================

REFRESH_COOKIE_NAME=opsflow_refresh_token

REFRESH_COOKIE_SAMESITE=lax


# ==========================================================
# LOGIN ABUSE PROTECTION
# ==========================================================

AUTH_THROTTLE_SECRET_KEY=replace-with-a-strong-random-secret

LOGIN_IP_MAX_ATTEMPTS=20

LOGIN_IP_WINDOW_SECONDS=60

LOGIN_ACCOUNT_MAX_FAILURES=8

LOGIN_ACCOUNT_WINDOW_SECONDS=900


# ==========================================================
# PASSWORD-RESET ABUSE PROTECTION
# ==========================================================

PASSWORD_RESET_IP_MAX_REQUESTS=10

PASSWORD_RESET_IP_WINDOW_SECONDS=900

PASSWORD_RESET_ACCOUNT_MAX_REQUESTS=3

PASSWORD_RESET_ACCOUNT_WINDOW_SECONDS=3600


# ==========================================================
# PASSWORD RESET DELIVERY
# ==========================================================

PASSWORD_RESET_URL=http://localhost:5173/reset-password


# ==========================================================
# AWS / SES
# ==========================================================

AWS_REGION=us-east-1

SES_FROM_EMAIL=admin@example.com

# Optional:
#
# SES_CONFIGURATION_SET_NAME=opsflow-email-events


# ==========================================================
# SECURITY EVENT LOGGING
# ==========================================================

SECURITY_EVENT_HMAC_KEY=replace-with-a-strong-random-secret


# ==========================================================
# AUTHENTICATION SESSION RETENTION
# ==========================================================

AUTH_SESSION_RETENTION_DAYS=30


# ==========================================================
# SERVICE-TO-SERVICE AUTHENTICATION
# ==========================================================
#
# The Compose environment supplies the same token to the
# Core Backend and Incident Service.
#
# Never expose this through a VITE_* variable.
#
# ==========================================================

INCIDENT_SERVICE_TOKEN=replace-with-a-shared-random-token-of-at-least-32-characters


# ==========================================================
# INCIDENT GATEWAY
# ==========================================================
#
# local:
#     Execute Incident Management through the in-process
#     LocalIncidentGateway.
#
# http:
#     Delegate Incident Management to the independently
#     running Incident Service.
#
# Host-side Backend development defaults to local mode.
# Docker Compose overrides this with http mode.
#
# The default URL below is the private Docker network URL.
# It is ignored while INCIDENT_GATEWAY_MODE=local.
#
# ==========================================================

INCIDENT_GATEWAY_MODE=local

INCIDENT_SERVICE_URL=http://incident-service:8000/api/v1

INCIDENT_SERVICE_TIMEOUT_SECONDS=3.0


# ==========================================================
# SAFE-READ RETRIES
# ==========================================================
#
# Total attempts include the initial request.
#
# 1 = no retry
# 2 = one retry
# 3 = two retries
#
# Mutating operations are never automatically retried.
#
# ==========================================================

INCIDENT_SERVICE_READ_MAX_ATTEMPTS=2

INCIDENT_SERVICE_READ_BACKOFF_SECONDS=0.1


# ==========================================================
# INCIDENT SERVICE CIRCUIT BREAKER
# ==========================================================
#
# Failed retry attempts within one logical operation count as
# one circuit failure.
#
# After the recovery interval, one half-open probe is allowed.
#
# ==========================================================

INCIDENT_SERVICE_CIRCUIT_FAILURE_THRESHOLD=3

INCIDENT_SERVICE_CIRCUIT_RECOVERY_SECONDS=15.0
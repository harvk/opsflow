APP_NAME=OpsFlow API
APP_ENV=development

API_V1_PREFIX=/api/v1

FRONTEND_ORIGIN=http://localhost:5173


# =========================================================
# DATABASE
# =========================================================

DATABASE_URL=postgresql+psycopg://opsflow:replace_me@localhost:5432/opsflow

TEST_DATABASE_URL=postgresql+psycopg://opsflow:replace_me@localhost:5432/opsflow_test


# =========================================================
# JWT
# =========================================================

JWT_SECRET_KEY=replace-with-a-strong-random-secret

JWT_REFRESH_SECRET_KEY=replace-with-a-strong-random-secret

JWT_REAUTH_SECRET_KEY=replace-with-a-strong-random-secret

JWT_ALGORITHM=HS256

JWT_ISSUER=opsflow-api

JWT_AUDIENCE=opsflow-web

ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=7


# =========================================================
# COOKIE
# =========================================================

REFRESH_COOKIE_NAME=opsflow_refresh_token

REFRESH_COOKIE_SAMESITE=lax


# =========================================================
# SECURITY
# =========================================================

CSRF_SECRET_KEY=replace-with-a-strong-random-secret

AUTH_THROTTLE_SECRET_KEY=replace-with-a-strong-random-secret

SECURITY_EVENT_HMAC_KEY=replace-with-a-strong-random-secret


# =========================================================
# AWS / SES
# =========================================================

AWS_REGION=us-east-1

SES_FROM_EMAIL=admin@example.com

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsflow.local/contracts/events/incident-task-completed-v1.schema.json",
  "title": "OpsFlow Incident Task Completed Event v1",
  "description": "Notification event emitted after an asynchronous incident-processing task has been durably reconciled into Incident Service state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "incident_id",
    "task_id",
    "correlation_id",
    "status",
    "acknowledged_at",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_type": {
      "const": "incident.task.completed"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "incident_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["Open", "Investigating", "Monitoring", "Resolved"]
    },
    "acknowledged_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

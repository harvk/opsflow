# ==========================================================
# OPSFLOW — DOCKER COMPOSE CONFIGURATION TEMPLATE
# ==========================================================
#
# Copy this file locally as:
#
#     .env.docker
#
# Never commit the real .env.docker file.
#
# Docker Compose does NOT automatically load a file named:
#
#     .env.docker
#
# Therefore run OpsFlow Compose commands as:
#
#     docker compose --env-file .env.docker <command>
#
# Examples:
#
#     docker compose --env-file .env.docker config
#     docker compose --env-file .env.docker up -d
#     docker compose --env-file .env.docker ps
#
# This file controls Docker orchestration and browser-public
# frontend build configuration.
#
# Backend application secrets belong in:
#
#     backend/.env
#
# ==========================================================


# ----------------------------------------------------------
# POSTGRESQL
# ----------------------------------------------------------

POSTGRES_USER=opsflow

# Replace in the real .env.docker file.
#
# Because this value is also incorporated into a PostgreSQL
# connection URL, use a URL-safe local-development password
# unless special characters are properly URL encoded.

POSTGRES_PASSWORD=replace_with_local_docker_password

POSTGRES_DB=opsflow

POSTGRES_HOST_PORT=5433


# ----------------------------------------------------------
# BACKEND CONTAINER / ORCHESTRATION
# ----------------------------------------------------------

PYTHON_VERSION=3.13.15

BACKEND_HOST_PORT=8000

FRONTEND_ORIGIN=http://localhost:5173


# ----------------------------------------------------------
# FRONTEND BUILD
# ----------------------------------------------------------

NODE_VERSION=24

FRONTEND_HOST_PORT=5173

# VITE_* values are PUBLIC browser configuration.
#
# Never place passwords, signing keys, access keys,
# credentials, or other secrets in a VITE_* variable.

VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_CSRF_COOKIE_NAME=opsflow_csrf
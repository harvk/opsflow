# ==========================================================
# OPSFLOW — DOCKER COMPOSE CONFIGURATION TEMPLATE
# ==========================================================
#
# Copy this file locally as:
#
#     .env.docker
#
# Never commit the real .env.docker file.
#
# Docker Compose does NOT automatically load a file named:
#
#     .env.docker
#
# Therefore run OpsFlow Compose commands as:
#
#     docker compose --env-file .env.docker <command>
#
# Examples:
#
#     docker compose --env-file .env.docker config
#     docker compose --env-file .env.docker up -d
#     docker compose --env-file .env.docker ps
#
# This file controls Docker orchestration and browser-public
# frontend build configuration.
#
# Backend application secrets belong in:
#
#     backend/.env
#
# ==========================================================


# ----------------------------------------------------------
# POSTGRESQL
# ----------------------------------------------------------

POSTGRES_USER=opsflow

# Replace in the real .env.docker file.
#
# Because this value is also incorporated into a PostgreSQL
# connection URL, use a URL-safe local-development password
# unless special characters are properly URL encoded.

POSTGRES_PASSWORD=replace_with_local_docker_password

POSTGRES_DB=opsflow

POSTGRES_HOST_PORT=5433


# ----------------------------------------------------------
# BACKEND CONTAINER / ORCHESTRATION
# ----------------------------------------------------------

PYTHON_VERSION=3.13.15

BACKEND_HOST_PORT=8000

FRONTEND_ORIGIN=http://localhost:5173


# ----------------------------------------------------------
# FRONTEND BUILD
# ----------------------------------------------------------

NODE_VERSION=24

FRONTEND_HOST_PORT=5173

# VITE_* values are PUBLIC browser configuration.
#
# Never place passwords, signing keys, access keys,
# credentials, or other secrets in a VITE_* variable.

VITE_API_BASE_URL=http://localhost:8000/api/v1

VITE_CSRF_COOKIE_NAME=opsflow_csrf


# ----------------------------------------------------------
# INTERNAL SERVICE AUTHENTICATION
# ----------------------------------------------------------
#
# Server-only shared credential. Never expose this through a
# VITE_* variable.

INCIDENT_SERVICE_TOKEN=replace_with_a_shared_random_token_of_at_least_32_characters

# ----------------------------------------------------------
# CORE SERVICE IDENTITY
# ----------------------------------------------------------
#
# The value below is a host-side file path, not PEM content.
#
# Generate the local-development keypair with:
#
#   ./backend/.venv/Scripts/python.exe \
#     scripts/generate_service_identity_keys.py
#
# The private key is mounted only into the Backend container.
# The matching public key is mounted only into the Incident
# Service container. Both are read-only Compose secrets.

CORE_SERVICE_IDENTITY_PRIVATE_KEY_FILE=./.opsflow-secrets/core-service-identity-private.pem

CORE_SERVICE_IDENTITY_PUBLIC_KEY_FILE=./.opsflow-secrets/core-service-identity-public.pem

SERVICE_IDENTITY_KEY_ID=core-backend-key-1

SERVICE_IDENTITY_ISSUER=opsflow-core-backend

SERVICE_IDENTITY_TOKEN_TTL_SECONDS=60

INCIDENT_SERVICE_AUDIENCE=opsflow-incident-service

SERVICE_IDENTITY_CLOCK_SKEW_SECONDS=5

# ----------------------------------------------------------
# INCIDENT GATEWAY CUTOVER AND RESILIENCE
# ----------------------------------------------------------

INCIDENT_GATEWAY_MODE=http

INCIDENT_SERVICE_URL=http://incident-service:8000/api/v1

# Per-attempt HTTP timeout.
INCIDENT_SERVICE_TIMEOUT_SECONDS=3.0

# Total safe-read attempts, including the initial request.
#
# 1 = no retry
# 2 = one retry
# 3 = two retries
INCIDENT_SERVICE_READ_MAX_ATTEMPTS=2

# Initial exponential-backoff delay in seconds.
INCIDENT_SERVICE_READ_BACKOFF_SECONDS=0.1

# Number of consecutive failed logical operations required
# to open the process-local circuit.
INCIDENT_SERVICE_CIRCUIT_FAILURE_THRESHOLD=3

# Seconds before the open circuit allows one probe request.
INCIDENT_SERVICE_CIRCUIT_RECOVERY_SECONDS=15.0

# ----------------------------------------------------------
# OPERATIONAL METRICS
# ----------------------------------------------------------
#
# Enables the Prometheus exposition endpoint at /metrics in
# both Python application services.

METRICS_ENABLED=true

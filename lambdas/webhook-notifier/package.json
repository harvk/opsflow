    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1137.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "24.13.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}

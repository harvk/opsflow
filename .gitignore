# Environment variables
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env.example
backend/.venv/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.ruff_cache/
backend/.env

# Python bytecode
*.py[cod]

# ==========================================================
# Python generated packaging metadata
# ==========================================================

*.egg-info/

# ==========================================================
# Local migration recovery artifacts
# ==========================================================

backend/migrations_backup/
backend/reset_migration.sql

# Node / React
node_modules/
dist/
coverage/

# IDEs
.vscode/
.idea/

# Operating systems
.DS_Store
Thumbs.db

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Secrets
*.pem
*.key

# Logs
*.log.env.docker
.env.docker

cat >> .gitignore <<'EOF'

# ==========================================================
# SAFE ENVIRONMENT TEMPLATES
# ==========================================================
#
# Real environment files remain ignored.
# These example files contain placeholders only and are
# intentionally tracked so a fresh clone documents the
# required configuration.
#

!.env.docker.example
!backend/.env.example
EOF
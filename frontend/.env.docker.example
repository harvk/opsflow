# ==========================================================
# OPSFLOW FRONTEND — DOCKER BUILD CONFIGURATION TEMPLATE
# ==========================================================
#
# Vite environment values are browser-visible build
# configuration.
#
# They are consumed while Docker runs:
#
#     npm run build
#
# and become part of the compiled JavaScript bundle.
#
# They are NOT private runtime secrets.
#
# The production-style NGINX frontend container does not
# dynamically read VITE_* environment variables after the
# image has been built.
#
# Never put passwords, tokens, private keys, AWS secrets,
# database credentials, or other confidential values in a
# VITE_* variable.
#
# ==========================================================


# ----------------------------------------------------------
# FASTAPI API BASE URL
# ----------------------------------------------------------
#
# React executes in the user's browser rather than inside
# Docker's internal network.
#
# Therefore localhost refers to the host-published FastAPI
# port and is intentional for the local Docker environment.
#
# ----------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000/api/v1


# ----------------------------------------------------------
# CSRF COOKIE NAME
# ----------------------------------------------------------
#
# This must match the readable CSRF cookie name expected by
# the frontend API client.
#
# ----------------------------------------------------------

VITE_CSRF_COOKIE_NAME=opsflow_csrf
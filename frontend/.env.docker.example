# ==========================================================
# OPSFLOW FRONTEND — DOCKER ENVIRONMENT TEMPLATE
# ==========================================================
#
# Copy this file when establishing a new local Docker
# development environment.
#
# Every variable prefixed with VITE_ may become visible to
# browser-side JavaScript.
#
# Never put private credentials in this file.
#
# ==========================================================


# Browser-visible FastAPI endpoint.
#
# The browser accesses FastAPI through the Docker-published
# host port, so localhost is intentional here.

VITE_API_BASE_URL=http://localhost:8000/api/v1


# Name of the readable CSRF cookie created by FastAPI.

VITE_CSRF_COOKIE_NAME=opsflow_csrf
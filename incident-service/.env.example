# ==========================================================
# OPSFLOW INCIDENT SERVICE CONFIGURATION TEMPLATE
# ==========================================================
#
# Copy this file locally as:
#
#     incident-service/.env
#
# Never commit the real incident-service/.env file.
#
# Docker Compose will inject runtime values directly. The
# backend does not use a backend/.env.docker file, and this
# service does not introduce one.
#
# ==========================================================


APP_NAME=OpsFlow Incident Service

APP_ENV=development

API_V1_PREFIX=/api/v1


# ==========================================================
# INCIDENT DATABASES
# ==========================================================
#
# These URLs are for host-side development.
#
# Docker Compose injects container-network URLs using:
#
#     db:5432
#
# Replace the password in a real incident-service/.env file.
# Never commit that real file.
#
# ==========================================================

DATABASE_URL=postgresql+psycopg://opsflow:replace_with_local_docker_password@localhost:5433/opsflow_incidents

TEST_DATABASE_URL=postgresql+psycopg://opsflow:replace_with_local_docker_password@localhost:5433/opsflow_incidents_test


# ==========================================================
# CORE BACKEND SERVICE CATALOG
# ==========================================================

CORE_BACKEND_URL=http://localhost:8000/api/v1

INCIDENT_SERVICE_TOKEN=replace-with-a-shared-random-token-of-at-least-32-characters

SERVICE_CATALOG_TIMEOUT_SECONDS=3.0
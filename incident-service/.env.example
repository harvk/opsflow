# ==========================================================
# OPSFLOW INCIDENT SERVICE CONFIGURATION TEMPLATE
# ==========================================================
#
# Copy this file locally as:
#
#     incident-service/.env
#
# Never commit the real incident-service/.env file.
#
# Docker Compose injects Incident Service runtime values
# directly. This file supports host-side development,
# migrations, and tests.
#
# The Incident Service does not share backend/.env and does
# not introduce a separate .env.docker file.
#
# ==========================================================


# ==========================================================
# APPLICATION
# ==========================================================

APP_NAME=OpsFlow Incident Service

APP_ENV=development

API_V1_PREFIX=/api/v1

METRICS_ENABLED=true


# ==========================================================
# INCIDENT DATABASES
# ==========================================================
#
# These URLs are for host-side development.
#
# Docker Compose overrides them with addresses using:
#
#     db:5432
#
# Replace the password in the real local file.
#
# TEST_DATABASE_URL is consumed by test and migration
# infrastructure rather than the application Settings model.
#
# ==========================================================

DATABASE_URL=postgresql+psycopg://opsflow:replace_with_local_docker_password@localhost:5433/opsflow_incidents

TEST_DATABASE_URL=postgresql+psycopg://opsflow:replace_with_local_docker_password@localhost:5433/opsflow_incidents_test


# ==========================================================
# CORE BACKEND SERVICE CATALOG
# ==========================================================
#
# Host-side development uses localhost.
#
# Docker Compose overrides this with:
#
#     http://backend:8000/api/v1
#
# ==========================================================

CORE_BACKEND_URL=http://localhost:8000/api/v1

SERVICE_CATALOG_TIMEOUT_SECONDS=3.0


# ==========================================================
# INTERNAL SERVICE AUTHENTICATION
# ==========================================================
#
# This value must match the Backend's configured internal
# service token.
#
# Never expose it through a VITE_* variable.
#
# ==========================================================

INCIDENT_SERVICE_TOKEN=replace-with-a-shared-random-token-of-at-least-32-characters
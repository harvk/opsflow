# ==========================================================
# OPSFLOW INCIDENT SERVICE CONFIGURATION TEMPLATE
# ==========================================================
#
# Copy this file locally as:
#
#     incident-service/.env
#
# Never commit the real incident-service/.env file.
#
# Docker Compose injects Incident Service runtime values
# directly. This file supports host-side development,
# migrations, and tests.
#
# The Incident Service does not share backend/.env and does
# not introduce a separate .env.docker file.
#
# ==========================================================


# ==========================================================
# APPLICATION
# ==========================================================

APP_NAME=OpsFlow Incident Service

APP_ENV=development

API_V1_PREFIX=/api/v1

METRICS_ENABLED=true


# ==========================================================
# INCIDENT DATABASES
# ==========================================================
#
# These URLs are for host-side development.
#
# Docker Compose overrides them with addresses using:
#
#     db:5432
#
# Replace the password in the real local file.
#
# TEST_DATABASE_URL is consumed by test and migration
# infrastructure rather than the application Settings model.
#
# ==========================================================

DATABASE_URL=postgresql+psycopg://opsflow:replace_with_local_docker_password@localhost:5433/opsflow_incidents

TEST_DATABASE_URL=postgresql+psycopg://opsflow:replace_with_local_docker_password@localhost:5433/opsflow_incidents_test


# ==========================================================
# CORE BACKEND SERVICE CATALOG
# ==========================================================
#
# Host-side development uses localhost.
#
# Docker Compose overrides this with:
#
#     http://backend:8000/api/v1
#
# ==========================================================

CORE_BACKEND_URL=http://localhost:8000/api/v1

SERVICE_CATALOG_TIMEOUT_SECONDS=3.0


# ==========================================================
# RS256 SERVICE-IDENTITY VERIFICATION
# ==========================================================
#
# The Incident Service receives only Core Backend public
# keys. Never copy the Core Backend private key here.
#
# The host-side public key generated in Phase 10.3D is in
# the ignored project-root secrets directory:
#
#     .opsflow-secrets/core-service-identity-public.pem
#
# Docker Compose will override this path when the public key
# is mounted into the Incident Service container in 10.4D.
#
# The previous-key variables are optional and must either
# both be configured or both remain absent. They support a
# controlled two-key rotation window.
#
# ==========================================================

SERVICE_IDENTITY_ISSUER=opsflow-core-backend
SERVICE_IDENTITY_AUDIENCE=opsflow-incident-service
SERVICE_IDENTITY_KEY_ID=core-backend-key-1
SERVICE_IDENTITY_PUBLIC_KEY_FILE=../.opsflow-secrets/core-service-identity-public.pem
SERVICE_IDENTITY_CLOCK_SKEW_SECONDS=5

# Optional rotation key:
#
# SERVICE_IDENTITY_PREVIOUS_KEY_ID=core-backend-key-previous
# SERVICE_IDENTITY_PREVIOUS_PUBLIC_KEY_FILE=../.opsflow-secrets/core-service-identity-previous-public.pem


# ==========================================================
# INCIDENT SERVICE OUTBOUND SIGNING IDENTITY
# ==========================================================
#
# This is a different keypair from the Core Backend identity.
# The Incident Service owns this private key. The Core Backend
# will receive only the matching public key during cutover.
#
# ==========================================================

SERVICE_IDENTITY_SIGNING_PRIVATE_KEY_PATH=../.opsflow-secrets/incident-service-identity-private.pem
SERVICE_IDENTITY_SIGNING_KEY_ID=incident-service-key-1
SERVICE_IDENTITY_SIGNING_ISSUER=opsflow-incident-service
SERVICE_IDENTITY_SIGNING_TOKEN_TTL_SECONDS=60
CORE_BACKEND_AUDIENCE=opsflow-core-backend
